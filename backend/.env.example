# =============================================================================
# ClaimBlitz Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# -- General --
# ENVIRONMENT drives safe defaults. Set to "production" on Render so DEBUG
# resolves to false automatically even if DEBUG is left unset.
ENVIRONMENT=development
# DEBUG is optional. Leave unset to inherit from ENVIRONMENT (production=false,
# otherwise true). Set explicitly only to override. In production: DEBUG=false
DEBUG=true

# -- CORS --
# Comma-separated list of allowed frontend origins. Development falls back to
# the local Vite origins (http://localhost:5173, http://127.0.0.1:5173) when
# this is empty. In production set the deployed frontend origin, e.g.
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
# A literal "*" is ignored on purpose (credentialed wildcard CORS is unsafe).
CORS_ALLOW_ORIGINS=

# -- LLM Provider (Groq — free, fast, OpenAI-compatible) --
# Get your free API key at: https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# -- LLM Settings --
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
USE_OLLAMA_ONLY=false

# -- MongoDB --
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=claimblitz

# -- Pinecone Vector Memory (optional for dev) --
# For local dev without Pinecone, agents use in-memory keyword matching.
# For production semantic recall:
PINECONE_USE_LOCAL=false
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=claimblitz-memory

# -- Embeddings --
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# -- Redis (optional for dev — falls back to in-memory) --
REDIS_URL=redis://localhost:6379/0

# -- RabbitMQ (optional — only needed for Celery workers) --
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -- Security (optional for dev — bypassed in development mode) --
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
RATE_LIMIT_PER_MINUTE=60

# -- Observability (optional) --
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# -- Legacy (not used by new system, kept for reference) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
