# =============================================================================
# ClaimBitz Frontend — Environment Configuration
# =============================================================================
# Copy this file to .env (local) or set these as environment variables in your
# deployment platform (e.g. Vercel Project Settings → Environment Variables).
#
# Do NOT commit a real .env file.

# Base URL of the FastAPI backend (Render service).
# Value must be the backend BASE URL only — the app appends "/process" itself.
#
#   Correct:   https://claimbitz-api.onrender.com
#   Incorrect: https://claimbitz-api.onrender.com/process
#
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production example (set in Vercel, do not commit):
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
